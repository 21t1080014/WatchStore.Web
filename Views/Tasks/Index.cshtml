@model WatchStore.Web.Models.TaskListViewModel
@using WatchStore.Web.Entities
@{
    ViewData["Title"] = "Công việc của tôi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="mb-0">Công việc của tôi</h2>
    <a asp-action="Create" class="btn btn-primary">+ Thêm công việc</a>
</div>

@if (!Model.HasAnyTask)
{
    @* Chưa có task nào: mời tạo cái đầu tiên, không hiện bảng rỗng *@
    <div class="text-center py-5 border rounded bg-light">
        <p class="mb-3">Bạn chưa có công việc nào.</p>
        <a asp-action="Create" class="btn btn-primary">Tạo công việc đầu tiên</a>
    </div>
}
else
{
    <div class="mb-3">
        <span class="badge bg-secondary">Chưa làm: @Model.ToDoCount</span>
        <span class="badge bg-warning text-dark">Đang làm: @Model.InProgressCount</span>
        <span class="badge bg-success">Hoàn thành: @Model.DoneCount</span>
    </div>

    @* method="get" để điều kiện lọc nằm trên URL, chia sẻ link được *@
    <form asp-action="Index" method="get" class="row g-2 mb-3">
        <div class="col-md-4">
            <input name="keyword" value="@Model.Keyword"
                   class="form-control" placeholder="Tìm theo tiêu đề..." />
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select">
                <option value="">— Mọi trạng thái —</option>
                <option value="@((int)TaskItemStatus.ToDo)"
                        selected="@(Model.FilterStatus == TaskItemStatus.ToDo)">Chưa làm</option>
                <option value="@((int)TaskItemStatus.InProgress)"
                        selected="@(Model.FilterStatus == TaskItemStatus.InProgress)">Đang làm</option>
                <option value="@((int)TaskItemStatus.Done)"
                        selected="@(Model.FilterStatus == TaskItemStatus.Done)">Hoàn thành</option>
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-outline-secondary">Lọc</button>
            <a asp-action="Index" class="btn btn-link">Xóa lọc</a>
        </div>
    </form>

    @if (!Model.Items.Any())
    {
        <div class="alert alert-info">Không có công việc nào khớp điều kiện lọc.</div>
    }
    else
    {
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Tiêu đề</th>
                    <th>Trạng thái</th>
                    <th>Hạn</th>
                    <th style="width: 160px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr>
                        <td>
                            <strong>@item.Title</strong>
                            @if (!string.IsNullOrWhiteSpace(item.Description))
                            {
                                <div class="text-muted small">@item.Description</div>
                            }
                        </td>
                        <td>
                            @switch (item.Status)
                            {
                                case TaskItemStatus.ToDo:
                                    <span class="badge bg-secondary">Chưa làm</span>
                                    break;
                                case TaskItemStatus.InProgress:
                                    <span class="badge bg-warning text-dark">Đang làm</span>
                                    break;
                                case TaskItemStatus.Done:
                                    <span class="badge bg-success">Hoàn thành</span>
                                    break;
                            }
                        </td>
                        <td>
                            @(item.DueDate?.ToString("dd/MM/yyyy") ?? "—")
                        </td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-primary">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.Id"
                               class="btn btn-sm btn-outline-danger">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}