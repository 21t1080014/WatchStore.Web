@model WatchStore.Web.Models.TaskFormViewModel
@using WatchStore.Web.Entities

<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" autofocus />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>

<div class="mb-3">
    <label asp-for="Status" class="form-label"></label>
    @* asp-items sinh sẵn các <option> từ enum *@
    <select asp-for="Status" class="form-select"
            asp-items="Html.GetEnumSelectList<TaskItemStatus>()"></select>
</div>

<div class="mb-3">
    <label asp-for="DueDate" class="form-label"></label>
    <input asp-for="DueDate" type="date" class="form-control" />
    <span asp-validation-for="DueDate" class="text-danger"></span>
</div>